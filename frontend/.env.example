# Supabase Postgres, pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase Postgres, direct connection (port 5432) used by prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only, never expose to the browser. Lets the server store review photos
# for customers, who are not signed in. Without it the review form has no photo field.
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram order notifications
# Bot token from @BotFather; group chat id (starts with -100); your personal
# Telegram user id, the only account allowed to press order buttons.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ADMIN_ID=""
# Random string Telegram sends back on every webhook call (A-Z, a-z, 0-9, _ and -).
# Register the webhook once after deploying:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url=https://<your-domain>/api/telegram \
#     -d secret_token=<TELEGRAM_WEBHOOK_SECRET> \
#     -d 'allowed_updates=["callback_query","message"]'
# "message" is needed for the /open, /close and /status commands. Re-run this
# command if the webhook was registered before those commands existed.
TELEGRAM_WEBHOOK_SECRET=""

# Public https site URL, used for the "Open in Admin" button. Optional on
# Vercel, which provides the production domain automatically.
SITE_URL="https://<your-domain>"

# Merchant bKash number customers send payment to
BKASH_NUMBER="01XXXXXXXXX"
