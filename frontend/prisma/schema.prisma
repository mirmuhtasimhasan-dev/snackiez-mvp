generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  // Short label for round category icons, e.g. "Burgers" for "Burger Specials".
  shortName String?
  image     String?
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean     @default(true)
  stockQty    Int         @default(0)
  isFeatured  Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                String      @id @default(uuid())
  orderCode         String      @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  totalAmount       Float
  deliveryFee       Float       @default(0)
  note              String?
  telegramMessageId Int?
  status            OrderStatus @default(PENDING)
  payment           Payment?
  review            Review?
  createdAt         DateTime    @default(now())
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id])
  method       PaymentMethod
  status       PaymentStatus @default(UNPAID)
  amount       Float
  trxId        String?
  senderNumber String?
  createdAt    DateTime      @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  image     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id         String       @id @default(uuid())
  // Set for reviews left by a customer for a delivered order; null for
  // reviews added by admin.
  orderId    String?      @unique
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status     ReviewStatus @default(APPROVED)
  isVerified Boolean      @default(false)
  name       String
  text       String
  rating     Int
  image      String?
  source     String?
  isVisible  Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BKASH
}

enum PaymentStatus {
  PAID
  UNPAID
  FAILED
}

// Single row (id 1): contact links and store controls, edited in admin.
model SiteSettings {
  id             Int      @id @default(1)
  whatsappNumber String?
  phoneNumber    String?
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  deliveryFee    Int      @default(60)
  hoursText      String   @default("Open till 4 AM")
  // "HH:mm" in Asia/Dhaka. closeTime may be after midnight (18:00 to 04:00).
  openTime       String?
  closeTime      String?
  autoSchedule   Boolean  @default(false)
  isOpen         Boolean  @default(true)
  closedMessage  String   @default("We are closed right now. Please order again later.")
  updatedAt      DateTime @updatedAt
}

// One row per attempt on the public review page, for rate limiting by IP
// and by order code. Old rows are deleted as new ones arrive.
model ReviewAttempt {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Short creator reels shown in "Loved by Creators" on the home page.
model CreatorVideo {
  id           String   @id @default(uuid())
  creatorName  String
  handle       String?
  // Link to the original reel on Instagram.
  instagramUrl String?
  videoUrl     String
  posterUrl    String?
  isVisible    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}
